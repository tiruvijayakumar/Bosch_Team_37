{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "incident-report.provisional.schema.json",
  "title": "Incident report (PROVISIONAL - replace/adapt to the organisers' schema)",
  "x-provisional": true,
  "type": "object",
  "required": ["schema_version", "incident_id", "diagnosis", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "0.1-provisional" },
    "incident_id": { "type": "string", "pattern": "^[0-9]{3}$" },
    "detected_at": { "type": "string", "format": "date-time" },
    "alert": { "type": "string" },
    "diagnosis": {
      "type": "object",
      "required": ["failing_component", "root_cause", "category", "confidence", "escalate_to_human"],
      "additionalProperties": false,
      "properties": {
        "failing_component": { "type": "string", "minLength": 1, "description": "Service or container, e.g. payment" },
        "root_cause": { "type": "string", "minLength": 1 },
        "category": { "enum": ["application_fault", "infrastructure_fault", "traffic_load", "combined", "unknown"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "escalate_to_human": { "type": "boolean" },
        "unknowns": { "type": "array", "items": { "type": "string" } },
        "alternatives_ruled_out": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hypothesis", "reason"],
            "additionalProperties": false,
            "properties": { "hypothesis": { "type": "string" }, "reason": { "type": "string" } }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "source", "observation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["trace", "metric", "log", "container_health", "deploy_history"] },
          "source": { "type": "string", "description": "Tool and query that produced it" },
          "reference": { "type": "string", "description": "Trace ID, metric name, log timestamp, container name" },
          "observation": { "type": "string" },
          "timestamp": { "type": "string" },
          "verified": { "type": "boolean", "description": "Re-fetched during this run" }
        }
      }
    },
    "proposed_action": {
      "type": ["object", "null"],
      "required": ["action", "reason", "requires_human_approval"],
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["restart_service", "toggle_feature_flag", "throttle_load_generator", "scale_service", "escalate_only"] },
        "target": { "type": "string" },
        "parameters": { "type": "object" },
        "reason": { "type": "string" },
        "requires_human_approval": { "const": true },
        "dry_run_first": { "type": "boolean" },
        "rollback": { "type": "string" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected", "not_applicable"] },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string" }
      }
    },
    "action_taken": { "type": ["object", "null"] },
    "verification": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "recovered": { "type": ["boolean", "null"] },
        "checks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time", "event"],
        "additionalProperties": false,
        "properties": { "time": { "type": "string" }, "event": { "type": "string" } }
      }
    },
    "prevention": { "type": "array", "items": { "type": "string" } }
  }
}
